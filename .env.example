# URL pública de esta web. Alimenta metadataBase, el sitemap y las canónicas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo activar en producción, con dominio definitivo y contenido contrastado.
# Previews y localhost se mantienen fuera del índice aunque esta opción esté activa.
ALLOW_INDEXING=false

# Plataforma a la que apuntan los CTA.
NEXT_PUBLIC_APP_URL=https://acceso.prolinceacademia.com

# Mismo proyecto Supabase que el producto. Solo clave anónima:
# la service role key nunca entra en este repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
