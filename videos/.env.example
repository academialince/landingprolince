# Copia este archivo como .env.local (no se sube al repositorio) y rellénalo.

# Clave service_role del proyecto Supabase de la web (Project Settings → API Keys).
# Sirve para subir la pregunta del día al panel. Trátala como una contraseña.
SUPABASE_SERVICE_ROLE_KEY=

# Carpeta del banco de preguntas sincronizada con Google Drive para escritorio, por ejemplo:
#   Windows: G:\Mi unidad\GUARDIA CIVIL\TEST
#   macOS:   /Users/tu-usuario/Library/CloudStorage/GoogleDrive-academialince0@gmail.com/Mi unidad/GUARDIA CIVIL/TEST
PROLINCE_BANCO_DIR=
